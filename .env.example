# Copy to .env (never commit .env). Leave ANTHROPIC_API_KEY empty to run in demo/offline mode.

# --- Live tutoring (optional; strictly opt-in) -----------------------------
# Your own Anthropic API key. Stored only here and read only by the local Python server.
# Paste it into .env with an editor; never type it into a chat or commit it.
# This is separate from any Claude Code / claude.ai subscription or credits.
ANTHROPIC_API_KEY=

# Model ID used for live tutoring (configuration, not a secret).
# NOTE: this ID has NOT been verified against the API by this project. It only counts as
# working after a live request has actually succeeded (see `python -m app.check --ping`).
ANTHROPIC_MODEL=claude-sonnet-5-5

# Explicit opt-in. Live calls are refused unless this is 1 (and key + model are set).
TUTOR_LIVE_ENABLED=0

# --- Bounded live-test controls (brakes, NOT a dollar spending cap) ----------
# Max API requests per UTC day (every attempt counts: retries and citation repairs too).
TUTOR_LIVE_MAX_REQUESTS_PER_DAY=20
# Max output tokens per request (hard ceiling 4096 whatever you set).
ANTHROPIC_MAX_TOKENS=1500
# Extra attempts after a transient failure, 0-2. Each retry counts toward the daily cap.
TUTOR_LIVE_MAX_RETRIES=1
# Refuse to send prompts longer than this many characters (rough size guard).
TUTOR_LIVE_MAX_INPUT_CHARS=48000

# --- Local server ----------------------------------------------------------
# Bound to localhost by default. Do not expose publicly.
TUTOR_HOST=127.0.0.1
TUTOR_PORT=8000

# Where originals, the SQLite database, sessions and extracted text live (git-ignored)
TUTOR_DATA_DIR=./data

# Upload size limit in MB
TUTOR_MAX_UPLOAD_MB=25

# Force the non-FTS5 lexical fallback (testing only)
TUTOR_FORCE_NO_FTS=0
