# Copy to .env (never commit .env). Leave values empty to run in demo/offline mode.

# --- Live tutoring (optional; opt-in) -------------------------------------
# Your own Anthropic API key. Stored only here, read only by the Python server.
# This is separate from any Claude Code / claude.ai subscription or credits.
ANTHROPIC_API_KEY=

# Model ID to use for live tutoring. Deliberately has no default: look up a
# current model ID in Anthropic's documentation and paste it here.
ANTHROPIC_MODEL=

# Max output tokens per live reply (optional)
ANTHROPIC_MAX_TOKENS=2048

# --- Local server ----------------------------------------------------------
# Bound to localhost by default. Do not expose publicly.
TUTOR_HOST=127.0.0.1
TUTOR_PORT=8000

# Where originals, the SQLite database and extracted text live (git-ignored)
TUTOR_DATA_DIR=./data

# Upload size limit in MB
TUTOR_MAX_UPLOAD_MB=25

# Force the non-FTS5 lexical fallback (testing only)
TUTOR_FORCE_NO_FTS=0
